<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rap Names</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 560px; margin: 40px auto; padding: 0 16px; }
      ul { list-style: none; padding: 0; }
      li { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #ddd; }
      .stage-name { font-weight: bold; }
      .birth-name { flex: 1; color: #555; }
      form { display: flex; flex-wrap: wrap; gap: 8px; }
      input { flex: 1; padding: 8px; }
      button { padding: 6px 10px; cursor: pointer; }
    </style>
  </head>
  <body>
    <h1>Current Rappers</h1>

    <ul class="rappers">
      <% for (let i = 0; i < info.length; i++) { %>
        <li class="rapper" data-id="<%= info[i]._id %>">
          <span class="stage-name"><%= info[i].stageName %></span>
          <span class="birth-name"><%= info[i].birthName %></span>
          <span class="likes"><%= info[i].likes %> likes</span>
          <button class="like">Like</button>
          <button class="delete">Delete</button>
        </li>
      <% } %>
    </ul>

    <% if (info.length === 0) { %>
      <p>No rappers yet. Add one below.</p>
    <% } %>

    <h2>Add A Rapper:</h2>
    <form action="/addRapper" method="POST">
      <input type="text" placeholder="Stage Name" name="stageName" required />
      <input type="text" placeholder="Birth Name" name="birthName" required />
      <button type="submit">Add</button>
    </form>

    <script src="/main.js"></script>
  </body>
</html>